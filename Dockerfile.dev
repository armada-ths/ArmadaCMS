# Lightweight dev Dockerfile — Go backend only (no frontend build)
FROM golang:1.24-alpine

RUN apk update && apk upgrade && \
    apk add --no-cache bash git openssh

RUN go install github.com/air-verse/air@v1.61.1

WORKDIR /app
ENV PATH="/go/bin:${PATH}"

COPY go.mod go.sum ./
RUN go mod download

# Source is volume-mounted in docker-compose.dev.yml, no COPY needed.
# Air watches .go files and rebuilds on changes.

EXPOSE 8080

ENTRYPOINT ["air"]
