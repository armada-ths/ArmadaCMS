{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "prepare": "cd .. && husky",
    "type-check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint --fix ./src",
    "lint:check": "eslint ./src",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src",
    "test": "vitest run",
    "test:photos-browser": "vitest run --config vitest.photos.config.ts"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,css,json,md,mjs}": "prettier --write",
    "**/*.{ts,tsx,js,jsx}": "eslint --fix"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@uiw/react-md-editor": "^4.2.3",
    "axios": "^1.21.0",
    "ra-data-json-server": "^5.15.5",
    "ra-data-simple-rest": "^5.15.5",
    "react": "^19.3.1",
    "react-admin": "^5.15.5",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "^7.18.5",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "1.65.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "name": "armadacms",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=24.0.0"
