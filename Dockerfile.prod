# ----------------------
# Stage 1: Build React frontend
# ----------------------
FROM node:24-alpine AS frontend-builder

WORKDIR /frontend

RUN corepack enable && corepack prepare pnpm@11.1.2 --activate

COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend/ .
RUN pnpm run build

# Cache the small compiled assets separately from Node and node_modules.
FROM scratch AS frontend-assets
COPY --from=frontend-builder /frontend/dist /dist

# ----------------------
# Stage 2: Build Go binary
# ----------------------
FROM golang:1.26-alpine3.22 AS backend-builder

RUN apk add --no-cache bash git openssh build-base pkgconf vips-dev

WORKDIR /app
ENV GOCACHE=/go-build-cache

COPY go.mod go.sum ./
RUN go mod download

# Keep compiled third-party packages in a regular image layer so the registry
# cache can reuse them when application sources change. Update build/deps.txt
# when application code starts importing another external package.
COPY build/deps.txt ./build/deps.txt
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build $(cat build/deps.txt)

COPY main.go ./
COPY photo_worker.go ./
COPY Controllers/ ./Controllers/
COPY Flow/ ./Flow/
COPY audit/ ./audit/
COPY auth/ ./auth/
COPY db/ ./db/
COPY docs/ ./docs/
COPY models/ ./models/
COPY utils/ ./utils/

# libvips requires CGO and a dynamically linked runtime.
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -o /app/server .

# ----------------------
# Stage 3: Minimal production image
# ----------------------
FROM alpine:3.22

RUN apk --no-cache add ca-certificates tzdata vips

WORKDIR /app

# Copy compiled binary and frontend assets
COPY --from=backend-builder /app/server .
COPY --from=frontend-assets /dist ./frontend/dist

EXPOSE 8080

ENTRYPOINT ["./server"]
