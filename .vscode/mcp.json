{
  "servers": {
    "Filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${workspaceFolder}"
      ]
    },
    "ESLint (ArmadaCMS)": {
      "type": "stdio",
      "command": "npx",
      "cwd": "${workspaceFolder}/frontend",
      "args": ["-y", "@eslint/mcp@latest"]
    },
    "Playwright": {
      "type": "stdio",
      "command": "npx",
      "cwd": "${workspaceFolder}",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "markitdown (ArmadaCMS)": {
      "type": "stdio",
      "command": "uvx",
      "args": ["markitdown-mcp@0.0.1a4"],
      "env": {
        "UV_HTTP_TIMEOUT": "600",
        "UV_HTTP_MAX_RETRIES": "5"
      }
    }
  }
}
