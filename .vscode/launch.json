{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Docker",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose -f docker-compose.dev.yml up",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "startDebugging",
        "name": "Admin Browser",
        "pattern": "Local:\\s+(https?://[^\\s]+)"
      }
    },
    {
      "name": "API",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Admin Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend",
      "serverReadyAction": {
        "action": "startDebugging",
        "name": "Admin Browser",
        "pattern": "Local:\\s+(https?://[^\\s]+)"
      }
    },
    {
      "name": "Admin Browser",
      "type": "editor-browser",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "API + Admin Dev",
      "configurations": ["API", "Admin Dev"],
      "stopAll": true
    }
  ]
}
