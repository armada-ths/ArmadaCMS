{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker dev up",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "-f", "docker-compose.dev.yml", "up"],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "custom",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(__never_match_this__)$",
          "kind": "file",
          "file": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".+",
          "endsPattern": "Server running on http://localhost:8080"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "docker dev up --build",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "-f", "docker-compose.dev.yml", "up", "--build"],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "custom",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(__never_match_this__)$",
          "kind": "file",
          "file": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".+",
          "endsPattern": "Server running on http://localhost:8080"
        }
      },
      "group": "build"
    },
    {
      "label": "admin frontend + docker",
      "dependsOn": ["docker dev up"],
      "dependsOrder": "parallel",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "dev", "--", "--host", "127.0.0.1"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "custom",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(__never_match_this__)$",
          "kind": "file",
          "file": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".+",
          "endsPattern": "Local:\\s+http://[^\\s]+:5173"
        }
      }
    },
    {
      "label": "docker dev stop",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "-f", "docker-compose.dev.yml", "stop"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "docker dev down",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "-f", "docker-compose.dev.yml", "down"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
