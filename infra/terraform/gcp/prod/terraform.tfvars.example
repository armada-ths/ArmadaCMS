# ArmadaCMS GCP production — example variable values
# Copy relevant lines to a local terraform.tfvars for temporary local overrides,
# or set variables directly in the HCP Terraform workspace.
#
# Most non-secret production defaults are already committed in prod.auto.tfvars.
# Only override here if you need to deviate from those defaults.

project_id = "your-gcp-project-id"
region     = "europe-north2"

deploy_cloud_run_service = true
deletion_protection      = true
cloud_run_ingress        = "INGRESS_TRAFFIC_INTERNAL_LOAD_BALANCER"

manage_runtime_service_account     = true
manage_cloud_build_service_account = true
manage_secret_accessor_bindings    = true
manage_cloud_build_triggers        = true

cloud_run_cpu    = "1000m"
cloud_run_memory = "1Gi"

enable_vpc_egress            = true
manage_vpc_network_resources = true
vpc_network_name             = "armadacms-serverless"
vpc_subnetwork_name          = "armadacms-serverless-europe-north2"

enable_https_load_balancer     = true
lb_managed_certificate_domains = ["cms.example.com"]

# Terraform creates Secret Manager resources but secret values are added
# directly in GCP Secret Manager. Do not set github_app_private_key or
# secret_values in tfvars/HCP because their contents would enter Terraform state.
# Storage endpoint and bucket values come from armadacms-supabase-prod outputs.
#
# Example storage credential rotation:
#   gcloud secrets versions add SUPABASE_STORAGE_ACCESS_KEY_ID --data-file=-
#   gcloud secrets versions add SUPABASE_STORAGE_SECRET_ACCESS_KEY --data-file=-
