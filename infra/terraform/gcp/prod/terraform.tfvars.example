project_id   = "just-sunrise-491718-m9"
region       = "europe-north2"
environment  = "production"
service_name = "armadacms"
name_prefix  = "armadacms"

artifact_registry_repository_id = "cloud-run-source-deploy"
container_image_path            = "armadacms/armadacms"
bootstrap_image_tag             = "bootstrap"

deploy_cloud_run_service = false
allow_unauthenticated    = true
deletion_protection      = true
cloud_run_ingress        = "INGRESS_TRAFFIC_INTERNAL_LOAD_BALANCER"

manage_runtime_service_account = false
# Leave empty to fall back to the default compute service account, or set an explicit email.
cloud_run_service_account_email = ""
# In current production, Cloud Build triggers also run as the default compute service account.
cloud_build_service_account_email = ""
manage_cloud_build_triggers = true

cloud_run_cpu             = "1000m"
cloud_run_memory          = "1Gi"
cloud_run_timeout_seconds = 120
cloud_run_concurrency     = 10
min_instances             = 0
max_instances             = 2

enable_vpc_egress          = true
cloud_run_vpc_egress_mode  = "DIRECT_VPC"
manage_vpc_network_resources = false
vpc_network_name           = "default"
vpc_subnetwork_name        = "default"
vpc_subnet_cidr            = "10.226.0.0/20"
vpc_connector_name         = "armadacms-serverless"
vpc_connector_cidr         = "10.8.0.0/28"
vpc_egress                 = "ALL_TRAFFIC"
nat_router_name            = "armadacms-router"
nat_name                   = "armadacms-nat"
nat_ip_name                = "armadacms-nat-ip"

enable_https_load_balancer = false
lb_reserve_global_ip       = true
lb_enable_http_redirect    = true
lb_backend_timeout_seconds = 30

# If Terraform should manage the certificate, set domains here.
# lb_managed_certificate_domains = ["cms.armada.nu"]

# If the certificate already exists in GCP, reference its self-link or ID here instead.
# lb_existing_ssl_certificate_ids = [
#   "projects/just-sunrise-491718-m9/global/sslCertificates/cms-armada-nu-cert",
# ]

additional_plain_env_vars = {
  DB_HOST                       = "terraform-20250411194126172200000001.cg6cp6bnc2ao.eu-north-1.rds.amazonaws.com"
  DB_PORT                       = "5432"
  DB_USER                       = "postgres"
  DB_NAME                       = "armadacms"
  DB_SSLMODE                    = "require"
  S3_BUCKET                     = "armada-cms-files-e48105192c52"
  AWS_REGION                    = "eu-north-1"
  DB_MAX_OPEN_CONNS             = "10"
  DB_MAX_IDLE_CONNS             = "5"
  DB_CONN_MAX_LIFETIME_MINUTES  = "30"
  DB_CONN_MAX_IDLE_TIME_MINUTES = "10"
  AUDIT_LOG_RETENTION_DAYS      = "7"
}

# Optional: let Terraform create the first versions for the GitHub App key and
# ArmadaCMS runtime secrets. This is convenient, but the values will end up in
# Terraform state, so prefer an encrypted remote backend if you use it.
#
# github_app_private_key = <<-EOT
# -----BEGIN RSA PRIVATE KEY-----
# ...
# -----END RSA PRIVATE KEY-----
# EOT
#
# secret_values = {
#   DB_HOST               = "your-rds-hostname"
#   DB_PORT               = "5432"
#   DB_USER               = "armadacms"
#   DB_PASSWORD           = "super-secret-password"
#   DB_NAME               = "armadacms"
#   jwtsecret_laganda     = "very-long-random-secret"
#   EVENTRO_API           = "https://eventro.example/api"
#   EVENTRO_FAIR_ID       = "123"
#   EVENTRO_ORG           = "armada"
#   S3_BUCKET             = "your-s3-bucket"
#   AWS_REGION            = "eu-north-1"
#   AWS_ACCESS_KEY_ID     = "AKIA..."
#   AWS_SECRET_ACCESS_KEY = "..."
# }
