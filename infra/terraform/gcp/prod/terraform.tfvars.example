# ArmadaCMS GCP production — example variable values
# Copy relevant lines to a local terraform.tfvars for temporary local overrides,
# or set variables directly in the HCP Terraform workspace.
#
# Most non-secret production defaults are already committed in prod.auto.tfvars.
# Only override here if you need to deviate from those defaults.

project_id = "your-gcp-project-id"
region     = "europe-north2"

storage_provider = "s3"

deploy_cloud_run_service = true
deletion_protection      = true
cloud_run_ingress        = "INGRESS_TRAFFIC_INTERNAL_LOAD_BALANCER"

manage_runtime_service_account    = false
cloud_run_service_account_email   = ""  # leave empty to use default compute SA
cloud_build_service_account_email = ""  # leave empty to use default Cloud Build SA
manage_cloud_build_triggers       = true

cloud_run_cpu    = "1000m"
cloud_run_memory = "1Gi"

enable_vpc_egress   = true
vpc_network_name    = "default"
vpc_subnetwork_name = "default"

enable_https_load_balancer     = true
lb_managed_certificate_domains = ["cms.example.com"]

# Optional: let Terraform create secret versions.
# Values are stored in Terraform state — use an encrypted remote backend.
#
# github_app_private_key = <<-EOT
# -----BEGIN RSA PRIVATE KEY-----
# ...
# -----END RSA PRIVATE KEY-----
# EOT
#
# secret_values = {
#   DB_PASSWORD           = "super-secret-password"
#   jwtsecret_laganda     = "very-long-random-secret"
#   EVENTRO_API           = "https://eventro.example/api"
#   EVENTRO_ORG           = "armada"
#   AWS_ACCESS_KEY_ID     = "AKIA..."
#   AWS_SECRET_ACCESS_KEY = "..."
# }

# To switch Cloud Run to Supabase Storage while keeping the DB untouched:
# storage_provider              = "supabase"
# supabase_url                  = "https://rsdjnixgxqauonaofrwr.supabase.co"
# supabase_storage_s3_endpoint  = "https://rsdjnixgxqauonaofrwr.storage.supabase.co/storage/v1/s3"
# supabase_storage_bucket       = "armadacms-files"
# supabase_storage_region       = "eu-north-1"
#
# Then add the storage credentials directly in GCP Secret Manager
# (NOT via secret_values — that would put them in Terraform state):
#   gcloud secrets versions add armadacms-SUPABASE_STORAGE_ACCESS_KEY_ID --data-file=-
#   gcloud secrets versions add armadacms-SUPABASE_STORAGE_SECRET_ACCESS_KEY --data-file=-
