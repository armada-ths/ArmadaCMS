# Copy this file to backend.tf and fill in your HCP Terraform details.
# If you prefer local state during initial import, delete backend.tf and
# run `terraform init` — Terraform will use local state by default.

terraform {
  cloud {
    organization = "THS-Armada"

    workspaces {
      name = "armadacms-aws-prod"
    }
  }
}
