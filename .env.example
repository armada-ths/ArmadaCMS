# ===== Runtime =====
# Cloud Run injects PORT automatically in production.
# Locally, the app defaults to port 8080 if PORT is not set.
# PORT=8080

# ===== Database (required) =====
# Local development usually uses DB_SSLMODE=disable.
# For production RDS from Cloud Run, prefer DB_SSLMODE=require.
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=armadacms
DB_SSLMODE=disable

# Alternative local DB: Supabase CLI (`pnpx supabase start`)
# - If the Go backend runs in Docker Compose, use host.docker.internal so the
#   backend container can reach the local Supabase Postgres port on the host.
# - If the Go backend runs directly on your machine, use localhost instead.
# DB_HOST=host.docker.internal
# DB_PORT=54322
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=postgres
# DB_SSLMODE=disable

# docker-compose.dev.yml runs Postgres in-network at hostname `postgres`.
# For the production-style local container workflow, override DB_HOST to a container-reachable host such as host.docker.internal.
# LOCAL_POSTGRES_IMAGE=postgres:17

# Optional remote source DB settings for scripts/import-remote-db.ps1.
# Use these to clone a remote PostgreSQL database (prod or staging) into the
# local Docker Postgres instance started by docker-compose.dev.yml.
# SOURCE_DB_HOST=
# SOURCE_DB_PORT=5432
# SOURCE_DB_USER=
# SOURCE_DB_PASSWORD=
# SOURCE_DB_NAME=
# SOURCE_DB_SSLMODE=require
# SOURCE_DB_TOOLS_IMAGE=postgres:17
# LOCAL_DB_CONTAINER=armadacms-postgres

# Optional DB connection pool tuning.
# Sensible starting values for Cloud Run are shown below.
# DB_MAX_OPEN_CONNS=10
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME_MINUTES=30
# DB_CONN_MAX_IDLE_TIME_MINUTES=10

# Optional audit log retention in days. Defaults to 7.
# AUDIT_LOG_RETENTION_DAYS=7

# Optional GORM schema management toggle.
# Keep this enabled while the repo is still transitioning from runtime
# AutoMigrate to checked-in SQL migrations. For Supabase-managed environments,
# the long-term goal is to set this to false once migration parity is trusted.
# DB_ENABLE_AUTOMIGRATE=true

# ===== Auth =====
# Required in all environments; use a long random secret in production.
jwtsecret_laganda=

# ===== Initial admin user (optional) =====
# On startup, if the users table is empty and both vars are set, a single admin
# account is created automatically. Useful for a fresh local or staging DB.
# Has no effect once any users exist.
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=changeme

# ===== Eventro integration (needed for /api/v1/eventroexhibitors and /api/v1/eventroevents) =====
EVENTRO_API=
EVENTRO_FAIR_ID=
EVENTRO_ORG=

# ===== File storage (profile photos, exhibitor logos, event images) =====
# See README.md → "File uploads (MinIO)" for setup instructions.

# Storage provider selector.
# - s3: current AWS S3 / MinIO-compatible flow
# - supabase: Supabase Storage via its S3-compatible endpoint
STORAGE_PROVIDER=s3

# Local MinIO — default for Docker development (started automatically by docker-compose.dev.yml)
S3_BUCKET=armada-dev
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# AWS S3 — staging / production (comment out the MinIO block above and uncomment below)
# S3_BUCKET=
# AWS_REGION=eu-north-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Supabase Storage (server-side via S3-compatible API)
# Keep STORAGE_PROVIDER=s3 until you have created a Supabase bucket and generated
# S3-compatible storage access keys for the project.
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_STORAGE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# SUPABASE_STORAGE_BUCKET=armadacms-files
# SUPABASE_STORAGE_REGION=eu-north-1
# SUPABASE_STORAGE_ACCESS_KEY_ID=
# SUPABASE_STORAGE_SECRET_ACCESS_KEY=
