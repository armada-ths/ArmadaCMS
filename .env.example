# ===== Runtime =====
# Cloud Run injects PORT automatically in production.
# Locally, the app defaults to port 8080 if PORT is not set.
# PORT=8080

# ===== Database (required) =====
# Local development usually uses DB_SSLMODE=disable.
# For production RDS from Cloud Run, prefer DB_SSLMODE=require.
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=armadacms
DB_SSLMODE=disable

# docker-compose.dev.yml runs Postgres in-network at hostname `postgres`.
# For the production-style local container workflow, override DB_HOST to a container-reachable host such as host.docker.internal.
# LOCAL_POSTGRES_IMAGE=postgres:17

# Optional remote source DB settings for scripts/import-remote-db.ps1.
# Use these to clone a remote PostgreSQL database (prod or staging) into the
# local Docker Postgres instance started by docker-compose.dev.yml.
# SOURCE_DB_HOST=
# SOURCE_DB_PORT=5432
# SOURCE_DB_USER=
# SOURCE_DB_PASSWORD=
# SOURCE_DB_NAME=
# SOURCE_DB_SSLMODE=require
# SOURCE_DB_TOOLS_IMAGE=postgres:17
# LOCAL_DB_CONTAINER=armadacms-postgres

# Optional DB connection pool tuning.
# Sensible starting values for Cloud Run are shown below.
# DB_MAX_OPEN_CONNS=10
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME_MINUTES=30
# DB_CONN_MAX_IDLE_TIME_MINUTES=10

# Optional audit log retention in days. Defaults to 7.
# AUDIT_LOG_RETENTION_DAYS=7

# ===== Auth =====
# Required in all environments; use a long random secret in production.
jwtsecret_laganda=

# ===== Eventro integration (needed for /api/v1/eventroexhibitors and /api/v1/eventroevents) =====
EVENTRO_API=
EVENTRO_FAIR_ID=
EVENTRO_ORG=

# ===== File storage (profile photos, exhibitor logos, event images) =====
# See README.md → "File uploads (MinIO)" for setup instructions.

# Local MinIO — default for Docker development (started automatically by docker-compose.dev.yml)
S3_BUCKET=armada-dev
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# AWS S3 — staging / production (comment out the MinIO block above and uncomment below)
# S3_BUCKET=
# AWS_REGION=eu-north-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
