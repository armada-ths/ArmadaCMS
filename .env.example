# ===== Runtime =====
# Cloud Run injects PORT automatically in production.
# Locally, the app defaults to port 8080 if PORT is not set.
# PORT=8080

# ===== Database (required) =====
# Local development uses DB_SSLMODE=disable.
# For production (Supabase) from Cloud Run, use DB_SSLMODE=require.
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=armadacms
DB_SSLMODE=disable

# docker-compose.dev.yml runs Postgres in-network at hostname `postgres`.
# For the production-style local container workflow, override DB_HOST to a container-reachable host such as host.docker.internal.
# LOCAL_POSTGRES_IMAGE=postgres:17

# Optional remote source DB settings for scripts/import-remote-db.ps1.
# Use these to clone a remote PostgreSQL database (prod or staging) into the
# local Docker Postgres instance started by docker-compose.dev.yml.
# SOURCE_DB_HOST=
# SOURCE_DB_PORT=5432
# SOURCE_DB_USER=
# SOURCE_DB_PASSWORD=
# SOURCE_DB_NAME=
# SOURCE_DB_SSLMODE=require
# SOURCE_DB_TOOLS_IMAGE=postgres:17
# LOCAL_DB_CONTAINER=armadacms-postgres

# Optional DB connection pool tuning.
# Sensible starting values for Cloud Run are shown below.
# DB_MAX_OPEN_CONNS=10
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME_MINUTES=30
# DB_CONN_MAX_IDLE_TIME_MINUTES=10

# Optional audit log retention in days. Defaults to 7.
# AUDIT_LOG_RETENTION_DAYS=7

# GORM AutoMigrate runs on startup when this is true (or unset). Set to false
# if you want to manage schema entirely through checked-in SQL migrations.
# DB_ENABLE_AUTOMIGRATE=true

# ===== Auth =====
# Required in all environments; use a long random secret in production.
jwtsecret_laganda=

# Optional comma-separated browser origins in addition to armada.nu and local
# development defaults. Origins must include scheme and must match exactly.
# CORS_ALLOWED_ORIGINS=https://preview.example.com

# Initial admin user seeding — only takes effect when no users exist yet.
# Leave empty once real accounts have been created.
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=

# ===== Eventro integration =====
EVENTRO_API=
EVENTRO_ORG=

# ===== File storage (profile photos, exhibitor logos, event images) =====

# Local MinIO — default for Docker development (started automatically by docker-compose.dev.yml)
S3_BUCKET=armada-dev
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Docker Compose only — MinIO root credentials for the local MinIO container
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Supabase Storage — for staging/production, point the same vars at Supabase's S3-compatible endpoint.
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public
# S3_BUCKET=armadacms-files
# S3_REGION=eu-north-1
# AWS_ACCESS_KEY_ID=<supabase-s3-access-key>
# AWS_SECRET_ACCESS_KEY=<supabase-s3-secret-key>

# ===== On-demand revalidation (public site cache purge) =====
# When set, the CMS will POST to REVALIDATION_URL for write endpoints that are
# configured with revalidation tags, to purge the Next.js cache for the affected
# resource.
# REVALIDATION_URL=https://armada.nu/api/revalidate
# REVALIDATION_SECRET=
# VERCEL_AUTOMATION_BYPASS_SECRET=  # Required for staging/preview to bypass Vercel Deployment Protection
