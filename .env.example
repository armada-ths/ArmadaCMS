# ===== Database (required) =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=armadacms
DB_SSLMODE=disable

# ===== Eventro integration (needed for /api/v1/eventroexhibitors and /api/v1/eventroevents) =====
EVENTRO_API=
EVENTRO_FAIR_ID=
EVENTRO_ORG=

# ===== AWS S3 (needed for file uploads — profile photos, exhibitor logos, etc.) =====
S3_BUCKET=
# AWS credentials are resolved via the standard AWS credential chain.
# Only set these if you don't have ~/.aws/credentials or an IAM role configured.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-north-1
