# ===== Runtime =====
# Cloud Run injects PORT automatically in production.
# Locally, the app defaults to port 8080 if PORT is not set.
# PORT=8080

# ===== Database (required) =====
# Local development usually uses DB_SSLMODE=disable.
# For production RDS from Cloud Run, prefer DB_SSLMODE=require.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=armadacms
DB_SSLMODE=disable

# When the backend runs inside Docker (docker-compose.dev.yml) but PostgreSQL runs
# on the host machine or in the standalone docker-compose.db.yml stack, the backend
# container should connect via host.docker.internal instead of localhost.
# DB_HOST_DOCKER=host.docker.internal
# LOCAL_POSTGRES_IMAGE=postgres:17

# Optional remote source DB settings for scripts/import-remote-db.ps1.
# Use these to clone a remote PostgreSQL database (prod or staging) into the
# local Docker Postgres instance started by docker-compose.db.yml.
# SOURCE_DB_HOST=
# SOURCE_DB_PORT=5432
# SOURCE_DB_USER=
# SOURCE_DB_PASSWORD=
# SOURCE_DB_NAME=
# SOURCE_DB_SSLMODE=require
# SOURCE_DB_TOOLS_IMAGE=postgres:17
# LOCAL_DB_CONTAINER=armadacms-postgres

# Optional DB connection pool tuning.
# Sensible starting values for Cloud Run are shown below.
# DB_MAX_OPEN_CONNS=10
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME_MINUTES=30
# DB_CONN_MAX_IDLE_TIME_MINUTES=10

# ===== Auth =====
# Required in all environments; use a long random secret in production.
jwtsecret_laganda=

# ===== Eventro integration (needed for /api/v1/eventroexhibitors and /api/v1/eventroevents) =====
EVENTRO_API=
EVENTRO_FAIR_ID=
EVENTRO_ORG=

# ===== AWS S3 (needed for file uploads — profile photos, exhibitor logos, etc.) =====
S3_BUCKET=
AWS_REGION=eu-north-1
# AWS credentials are resolved via the standard AWS credential chain.
# Only set these if you don't have ~/.aws/credentials or an IAM role configured.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
